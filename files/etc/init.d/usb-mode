#!/bin/sh /etc/rc.common
# USB 角色自动切换（6.12/6.18 自适应）
# 注意：默认 gadget 由 openstick-tweaks 处理
# 本脚本只负责：检测到外部 USB 设备时切换到 host

START=25
# ↑ START=25，晚于 openstick-tweaks（推测 START=20）
# 确保 RNDIS gadget 已建立后再检测外部设备

STOP=99

find_role_path() {
    # 6.18 debugfs 接口
    if [ -f "/sys/kernel/debug/usb/ci_hdrc.0/role" ]; then
        echo "debugfs:/sys/kernel/debug/usb/ci_hdrc.0/role"
        return 0
    fi
    # 6.12 sysfs 接口
    for node in /sys/class/usb_role/*/role; do
        if [ -f "$node" ]; then
            echo "sysfs:$node"
            return 0
        fi
    done
    echo ""
}

start() {
    # 等待 openstick-tweaks 完成 gadget 初始化
    sleep 5

    USB_ROLE_PATH=""
    ROLE_INFO=$(find_role_path)

    if [ -z "$ROLE_INFO" ]; then
        logger -t usb-mode "⚠ 未找到 role 节点，跳过切换"
        return 0
    fi

    INTERFACE_TYPE="${ROLE_INFO%%:*}"
    ROLE_PATH="${ROLE_INFO#*:}"

    # 检测外部 USB 设备数量
    # 过滤掉 root hub 和内部设备，只统计真实外部设备
    HOST_DEVICES=$(ls /sys/bus/usb/devices/ 2>/dev/null \
        | grep -v "^usb" \
        | grep -v "\-0:" \
        | wc -l)

    logger -t usb-mode "检测到外部 USB 设备数: $HOST_DEVICES"
    logger -t usb-mode "接口类型: $INTERFACE_TYPE | 节点: $ROLE_PATH"

    if [ "$HOST_DEVICES" -gt "0" ]; then
        # 有外部设备 → 切换到 host 模式
        case "$INTERFACE_TYPE" in
            debugfs)
                echo "host" > "$ROLE_PATH" 2>/dev/null
                ;;
            sysfs)
                echo "host" > "$ROLE_PATH" 2>/dev/null
                ;;
        esac
        logger -t usb-mode "✅ 检测到外部设备，已切换到 host 模式"
    else
        # 无外部设备 → 保持当前 gadget/device 模式（不干预）
        CURRENT=$(cat "$ROLE_PATH" 2>/dev/null || echo "未知")
        logger -t usb-mode "无外部设备，保持当前模式: $CURRENT（不干预 RNDIS）"
    fi
}

stop() {
    logger -t usb-mode "服务停止"
}
