#!/bin/sh
# 首次开机自动启用 WiFi（中国区域合规配置）
# uci-defaults 机制：执行成功后自动删除，只运行一次

# 等待无线子系统初始化完成
sleep 2

# 检查是否存在无线配置
if uci show wireless > /dev/null 2>&1; then

    # 关闭 disabled 标记，启用 WiFi
    uci set wireless.radio0.disabled='0' 2>/dev/null || true

    # 设置国家码为中国（解锁 1-13 信道，合规使用）
    uci set wireless.radio0.country='CN' 2>/dev/null || true

    # 设置信道 6（中国 2.4GHz 三个无干扰信道之一：1/6/11）
    uci set wireless.radio0.channel='6' 2>/dev/null || true

    # 设置频宽 20MHz（兼容性最好，避免干扰）
    uci set wireless.radio0.htmode='HT20' 2>/dev/null || true

    # 获取主机名作为 SSID
    HOSTNAME=$(uci get system.@system[0].hostname 2>/dev/null || echo "ImmortalWrt")

    # 配置 AP 接入点
    uci set wireless.default_radio0=wifi-iface 2>/dev/null || true
    uci set wireless.default_radio0.device='radio0' 2>/dev/null || true
    uci set wireless.default_radio0.mode='ap' 2>/dev/null || true
    uci set wireless.default_radio0.ssid="${HOSTNAME}" 2>/dev/null || true
    # 开放网络，不设密码
    uci set wireless.default_radio0.encryption='none' 2>/dev/null || true
    uci set wireless.default_radio0.network='lan' 2>/dev/null || true

    # 提交并应用
    uci commit wireless
    wifi up 2>/dev/null || true

    logger -t wifi-setup "WiFi 已启用 | SSID: ${HOSTNAME} | 信道: 6 | 国家码: CN | 无密码"
else
    logger -t wifi-setup "未找到无线配置，跳过"
fi

exit 0