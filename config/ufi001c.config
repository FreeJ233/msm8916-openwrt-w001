# =================================================================
# 用户自定义插件区（可自由增删，每行单独一个包名）
# =================================================================

# -----------------------------------------------------------------
# USB 内核模块
# -----------------------------------------------------------------
# OTG 角色切换，gadget 模式必须
CONFIG_PACKAGE_kmod-usb-role-switch=y
# USB Hub 支持，外接 Hub 必须（Genesys 05e3:0610）
CONFIG_PACKAGE_kmod-usb2=y
# RNDIS 网络共享
CONFIG_PACKAGE_kmod-usb-net-rndis=y
# USB 网卡基础依赖
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-scsi-core=y
# SD 卡文件系统支持
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# USB 设备识别工具
CONFIG_PACKAGE_usbutils=y
# 以下 USB 包不需要
# CONFIG_PACKAGE_kmod-usb-gadget-serial is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ncm is not set
# CONFIG_PACKAGE_kmod-usb-serial is not set
# CONFIG_PACKAGE_kmod-usb-serial-ch341 is not set
# CONFIG_PACKAGE_kmod-usb-serial-cp210x is not set
# CONFIG_PACKAGE_kmod-usb-serial-ftdi is not set
# CONFIG_PACKAGE_kmod-usb-serial-option is not set
# CONFIG_PACKAGE_kmod-usb-serial-pl2303 is not set
# CONFIG_PACKAGE_kmod-usb-serial-wwan is not set
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set

# -----------------------------------------------------------------
# WiFi 驱动
# -----------------------------------------------------------------
# WCN3620 使用 wcn36xx，ath9k 系列与本设备无关
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath9k is not set
# CONFIG_PACKAGE_kmod-ath9k-htc is not set

# -----------------------------------------------------------------
# 网络内核模块
# -----------------------------------------------------------------
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y

# -----------------------------------------------------------------
# 文件系统内核模块
# -----------------------------------------------------------------
CONFIG_PACKAGE_kmod-fs-cifs=y

# -----------------------------------------------------------------
# LED 内核模块
# -----------------------------------------------------------------
# GPIO LED 驱动（蓝GPIO20 绿GPIO21 红GPIO22）
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-gpio=y
# 以下 LED 模块不需要
# CONFIG_PACKAGE_kmod-ledtrig-heartbeat is not set
# CONFIG_PACKAGE_kmod-nft-netdev is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set
# CONFIG_PACKAGE_kmod-ledtrig-timer is not set
# CONFIG_PACKAGE_rssileds is not set

# -----------------------------------------------------------------
# 防火墙
# -----------------------------------------------------------------
CONFIG_PACKAGE_iptables-nft=y

# -----------------------------------------------------------------
# eMMC 扩容工具（openstick-tweaks 扩容依赖）
# -----------------------------------------------------------------
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y

# -----------------------------------------------------------------
# openstick 核心包（必须，不会自动勾选）
# -----------------------------------------------------------------
CONFIG_PACKAGE_openstick-tweaks=y

# -----------------------------------------------------------------
# 系统工具
# -----------------------------------------------------------------
CONFIG_PACKAGE_android-tools-adbd=y
CONFIG_PACKAGE_gc=y
CONFIG_PACKAGE_cifsmount=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_curl=y

# -----------------------------------------------------------------
# 语言扩展
# -----------------------------------------------------------------
CONFIG_PACKAGE_lua-curl-v3=y

# -----------------------------------------------------------------
# LuCI 核心（必须）
# -----------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# -----------------------------------------------------------------
# LuCI 主题
# -----------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# -----------------------------------------------------------------
# LuCI 协议
# -----------------------------------------------------------------
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_luci-proto-ppp=y

# -----------------------------------------------------------------
# LuCI 应用（用户可自由增删）
# -----------------------------------------------------------------
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-fileassistant=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-webadmin=y
# CONFIG_PACKAGE_luci-app-mmconfig is not set

# -----------------------------------------------------------------
# 可选插件（需要时删除行首 # 号启用）
# -----------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_lsblk is not set
